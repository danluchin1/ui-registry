{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "items": [
    {
      "name": "ifly-theme",
      "type": "registry:theme",
      "title": "iFly Theme",
      "description": "Travel-inspired blue and green theme tokens for iFly-style UI.",
      "cssVars": {
        "light": {
          "radius": "1rem",
          "primary": "oklch(0.546 0.245 262.881)",
          "primary-foreground": "oklch(0.985 0 0)",
          "success": "oklch(0.723 0.191 149.579)",
          "success-foreground": "oklch(0.985 0 0)",
          "brand-hero": "oklch(0.488 0.243 264.376)"
        }
      },
      "css": {
        "@theme inline": {
          "--color-success": "var(--success)",
          "--color-success-foreground": "var(--success-foreground)",
          "--color-brand-hero": "var(--brand-hero)"
        }
      }
    },
    {
      "name": "button",
      "type": "registry:ui",
      "title": "Button",
      "description": "Pill-shaped button with glass, success, and hero outline variants.",
      "dependencies": ["class-variance-authority", "radix-ui"],
      "files": [
        {
          "path": "src/components/button.tsx",
          "type": "registry:ui"
        }
      ]
    },
    {
      "name": "card",
