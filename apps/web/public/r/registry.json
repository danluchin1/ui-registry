{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "my-better-t-app",
  "homepage": "https://github.com/luchi/my-better-t-app",
  "items": [
    {
      "name": "ifly-theme",
      "title": "iFly Theme",
      "description": "Travel-inspired blue and green theme tokens for iFly-style UI.",
      "cssVars": {
        "light": {
          "radius": "1rem",
          "primary": "oklch(0.546 0.245 262.881)",
          "primary-foreground": "oklch(0.985 0 0)",
          "success": "oklch(0.723 0.191 149.579)",
          "success-foreground": "oklch(0.985 0 0)",
          "brand-hero": "oklch(0.488 0.243 264.376)"
        }
      },
      "css": {
        "@theme inline": {
          "--color-success": "var(--success)",
          "--color-success-foreground": "var(--success-foreground)",
          "--color-brand-hero": "var(--brand-hero)"
        }
      },
      "type": "registry:theme"
    },
    {
      "name": "button",
      "title": "Button",
      "description": "Pill-shaped button with glass, success, and hero outline variants.",
      "dependencies": [
        "class-variance-authority",
        "radix-ui"
      ],
      "files": [
        {
          "path": "packages/ui/src/components/button.tsx",
          "type": "registry:ui"
        }
      ],
      "type": "registry:ui"
    },
    {
      "name": "card",
      "title": "Card",
      "description": "Travel card with media, badges, and price display.",
      "files": [
        {
          "path": "packages/ui/src/components/card.tsx",
          "type": "registry:ui"
        }
      ],
      "type": "registry:ui"
    },
    {
      "name": "dropdown-menu",
      "title": "Dropdown Menu",
      "description": "Rounded dropdown menu styled for locale and currency pickers.",
      "dependencies": [
        "radix-ui",
        "lucide-react"
      ],
      "files": [
        {
          "path": "packages/ui/src/components/dropdown-menu.tsx",
          "type": "registry:ui"
        }
      ],
      "type": "registry:ui"
    },
    {
      "name": "input",
      "title": "Input",
      "description": "Minimal border-input field styled for travel query text entry.",
      "files": [
        {
          "path": "packages/ui/src/components/input.tsx",
          "type": "registry:ui"
        }
      ],
      "type": "registry:ui"
    }
  ]
}